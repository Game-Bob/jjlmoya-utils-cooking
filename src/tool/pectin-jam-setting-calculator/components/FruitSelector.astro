---
interface Fruit {
  id: string;
  pectin: string;
  acidity: string;
  color: string;
}

interface Props {
  ui: Record<string, string>;
  fruits: Fruit[];
}

const { ui, fruits } = Astro.props;
---

<div class="jam-field">
  <span class="jam-sec-head">{ui.fruitLabel}</span>
  <div class="jam-filter-tabs" id="jam-filter-tabs">
    <button class="jam-filter-tab active" data-filter="all">{ui.allFruits}</button>
    <button class="jam-filter-tab" data-filter="high">{ui.highPectin}</button>
    <button class="jam-filter-tab" data-filter="medium">{ui.mediumPectin}</button>
    <button class="jam-filter-tab" data-filter="low">{ui.lowPectin}</button>
  </div>
  <div class="jam-fruit-grid" id="fruit-scroll">
    {fruits.map((fruit) => {
      const fruitName = ui[`fruit_${fruit.id}`] || fruit.id;
      return (
        <button
          class="jam-fruit-chip"
          data-fruit={fruit.id}
          data-pectin={fruit.pectin}
          data-acidity={fruit.acidity}
          data-color={fruit.color}
          style={`--fruit-color:${fruit.color}`}
          aria-label={fruitName}>
          <span class="jam-fruit-chip-dot" style={`background:${fruit.color}`}></span>
          <span class="jam-fruit-chip-name">{fruitName}</span>
        </button>
      );
    })}
  </div>
</div>
