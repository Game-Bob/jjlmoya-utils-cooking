---
interface Props {
  ui: Record<string, string>;
}

const { ui } = Astro.props;
---

<div class="jam-status perfect" id="drop-status">
  <span class="jam-status-icon" id="drop-status-icon"></span>
  <span class="jam-status-text" id="drop-status-text"></span>
</div>

<div class="jam-drop-scene" id="plate-stage">
  <span class="jam-drop-hint-text">{ui.dropTestTitle} — {ui.dropTestHow}</span>
  <svg class="jam-drop-svg" viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="drop-grad" cx="40%" cy="35%">
        <stop offset="0%" stop-color="var(--jam-fruit-color-light)" />
        <stop offset="60%" stop-color="var(--jam-fruit-color)" />
        <stop offset="100%" stop-color="var(--jam-fruit-color-dark)" />
      </radialGradient>
      <filter id="drop-shadow">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.3" />
      </filter>
    </defs>
    <ellipse cx="120" cy="148" rx="88" ry="16" fill="none" stroke="currentColor" stroke-width="2.5" opacity="0.3" />
    <ellipse cx="120" cy="144" rx="88" ry="16" fill="none" stroke="currentColor" stroke-width="1" opacity="0.1" />
    <ellipse id="jam-drop" class="jam-drop" cx="120" cy="30" rx="18" ry="15" fill="url(#drop-grad)" filter="url(#drop-shadow)" />
    <ellipse id="jam-drop-highlight" class="jam-drop-highlight" cx="114" cy="22" rx="6" ry="3.5" fill="white" opacity="0.45" />
  </svg>
</div>
