---
interface Props {
  ui: Record<string, string>;
}

const { ui } = Astro.props;
---

<div class="jam-field">
  <div class="jam-field-row">
    <label class="jam-sec-head" for="fruit-weight">{ui.weightLabel}</label>
  </div>
  <div class="jam-weight-ctrl">
    <button class="jam-weight-step" data-dir="down" data-target="fruit-weight">-</button>
    <input type="number" id="fruit-weight" class="jam-weight-num" value="1000" min="10" max="99999" />
    <span class="jam-weight-unit" id="weight-unit-label">{ui.weightUnitMetric}</span>
    <button class="jam-weight-step" data-dir="up" data-target="fruit-weight">+</button>
  </div>
</div>

<div class="jam-field">
  <span class="jam-sec-head">{ui.pectinTypeLabel}</span>
  <div class="jam-seg" id="pectin-toggle">
    <button class="jam-seg-btn active" data-value="HM">{ui.pectinHM}</button>
    <button class="jam-seg-btn" data-value="LM">{ui.pectinLM}</button>
  </div>
</div>

<div class="jam-field">
  <div class="jam-field-row">
    <label class="jam-sec-head" for="sugar-weight">{ui.sugarLabel}</label>
    <button class="jam-auto-tag" id="jam-auto-btn">{ui.sugarModeAuto}</button>
  </div>
  <div class="jam-slider-wrap">
    <input type="range" id="sugar-weight" class="jam-slider" min="0" max="2000" step="10" value="1000" />
    <span class="jam-slider-val" id="jam-sugar-display">1000 g</span>
  </div>
  <span class="jam-auto-hint" id="sugar-auto-hint">{ui.sugarAutoHint}</span>
</div>
