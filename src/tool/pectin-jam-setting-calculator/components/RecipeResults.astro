---
interface Props {
  ui: Record<string, string>;
}

const { ui } = Astro.props;
---

<div id="recipe-section">
  <div class="jam-ing-grid">
    <div class="jam-ing-card">
      <div class="jam-ing-val"><span id="pectin-val">0.0</span><span class="jam-ing-unit">g</span></div>
      <div class="jam-ing-name">{ui.pectinNeeded}</div>
    </div>
    <div class="jam-ing-card">
      <div class="jam-ing-val"><span id="citric-val">0.0</span><span class="jam-ing-unit">g</span></div>
      <div class="jam-ing-name">{ui.citricAcidNeeded}</div>
      <div class="jam-ing-sub" id="lemon-val"></div>
    </div>
    <div class="jam-ing-card">
      <div class="jam-ing-val"><span id="sugar-val">1000</span><span class="jam-ing-unit">g</span></div>
      <div class="jam-ing-name">{ui.sugarNeeded} <span id="sugar-hint"></span></div>
    </div>
    <div class="jam-ing-card">
      <div class="jam-ing-val"><span id="yield-val">2000</span><span class="jam-ing-unit">g</span></div>
      <div class="jam-ing-name">{ui.totalYield}</div>
    </div>
  </div>

  <div class="jam-gauge">
    <div class="jam-gauge-head">
      <span class="jam-gauge-label">{ui.sugarPercent}</span>
      <span class="jam-gauge-pct"><span id="sugar-pct-val">39</span>% <span class="jam-gauge-ctx" id="sugar-pct-context"></span></span>
    </div>
    <div class="jam-gauge-track">
      <div class="jam-gauge-needle" id="jam-gauge-needle"></div>
    </div>
    <div class="jam-gauge-ticks">
      <span>0%</span>
      <span>{ui.sugarLow}</span>
      <span class="jam-gauge-ideal-label">{ui.sugarIdeal}</span>
      <span>{ui.sugarHigh}</span>
    </div>
  </div>
</div>
